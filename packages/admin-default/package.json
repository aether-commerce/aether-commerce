{
  "name": "@aether-commerce/admin-default",
  "version": "0.3.2",
  "private": false,
  "license": "SEE LICENSE IN LICENSE.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aether-commerce/aether-commerce.git",
    "directory": "packages/admin-default"
  },
  "type": "module",
  "files": [
    "dist",
    "bin",
    "admin-routes.manifest.json"
  ],
  "bin": {
    "aether-admin-routes": "./bin/aether-admin-routes.mjs"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src && node --check bin/aether-admin-routes.mjs"
  },
  "dependencies": {
    "@aether-commerce/config-schema": "workspace:*",
    "@aether-commerce/core": "workspace:*",
    "@aether-commerce/i18n": "workspace:*",
    "@aether-commerce/ui": "workspace:*",
    "clsx": "^2.1.1",
    "lucide-react": "^1.24.0"
  },
  "peerDependencies": {
    "@clerk/react": "*",
    "next": "^16.0.0",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@clerk/react": "^6.12.3",
    "@types/react": "^19.2.3",
    "next": "^16.3.0",
    "react": "^19.2.3",
    "typescript": "^5.9.0"
  }
}
